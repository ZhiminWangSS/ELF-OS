<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- Retry up to 3 times on any pipeline failure (typical case: a newly
         marked mid-path obstacle makes FollowPath fail between replans).
         Recovery clears ghost marks from the local costmap; the retried
         pipeline replans at 2 Hz around real obstacles. No spin/backup.
         (Wait node omitted: its self-hosted action server deadlocks
         bt_navigator configuration on this Foxy.) -->
    <RecoveryNode number_of_retries="3">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="2.0">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" server_timeout="1000"/>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" server_timeout="1000"/>
      </PipelineSequence>
      <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
    </RecoveryNode>
  </BehaviorTree>
</root>
